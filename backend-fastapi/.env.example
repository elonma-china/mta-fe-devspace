FRONTEND_ORIGIN=http://localhost:3000
HOST=localhost
PORT=5050
JWT_EXPIRES_IN=24h
# JWT_SECRET=  # Set in production! Falls back to random ephemeral secret if unset.
LLM_API_KEY=  # Optional upstream API key


# AI services
# AI_SERVICE_HOST=https://chickgroup-ai1.hpda.vn/api/v1
AI_SERVICE_HOST=http://localhost:5001/api/v1
AI_INGEST_HOST=http://localhost:5002/api/v1
ZOMBIE_TASK_TIMEOUT_MS=1800000

# Document status listener (bug 1) — subscribes to the ingest service's Redis
# pub/sub so "Đang xử lý" is cleared even when no browser is open.
# The three values below MUST match mta-be-intramind's .env; a mismatch is
# silent (the listener just never receives anything).
STATUS_LISTENER_ENABLED=true
REDIS_URL=redis://localhost:6379
STATUS_PUBSUB_REDIS_DB=2
STATUS_PUBSUB_CHANNEL_PREFIX=doc-status

# PostgreSQL Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=intramind

# MongoDB Connection
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongoadmin
MONGO_DB=intramind
