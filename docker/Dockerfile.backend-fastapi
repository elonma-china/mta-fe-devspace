# Dockerfile.backend-fastapi — gateway/BFF (:5050), image intramind/fe-gateway.
# Build context là GỐC REPO (compose đặt context: ..).
#
# Multi-stage theo rule docker của repo này: build-essential chỉ sống ở stage
# builder (asyncpg/bcrypt có wheel cp312 sẵn, nhưng giữ builder để một pin đổi
# sang sdist không phá build); runtime chỉ có venv + curl (cho HEALTHCHECK,
# cùng kiểu curl -sf như các tier be/ai). Base -bookworm cho khớp chuẩn
# python:3.12-slim-bookworm của workspace.
FROM python:3.12-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY backend-fastapi/requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --retries 10 --timeout 300 \
       -r /tmp/requirements.txt

FROM python:3.12-slim-bookworm

LABEL org.opencontainers.image.title="intramind-fe-gateway" \
      org.opencontainers.image.description="IntraMind FE gateway/BFF — auth, RBAC, Postgres/Mongo, proxy sang AI (:5001) va BE (:5002)"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

# Non-root: khác các tier be/ai (chạy root) — rule docker của repo NÀY bắt
# non-root, và image này còn được db-seed dùng lại nên user phải đọc được
# /seed mount ro (world-readable, không vấn đề).
RUN useradd -u 10001 -m appuser && chown -R appuser:appuser /app
USER appuser

COPY --chown=appuser:appuser backend-fastapi/ .

EXPOSE 5050

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD curl -sf http://localhost:5050/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5050"]
