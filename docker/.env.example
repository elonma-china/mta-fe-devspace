# .env.example — chép thành docker/.env rồi chỉnh. Compose đọc file này từ
# CHÍNH thư mục docker/ (nơi chứa docker-compose-v2.yml); các script deploy/
# cũng ghi/đọc ở đây.
#
# Mọi khoá đều có mặc định chạy được trong compose — chỉ JWT_SECRET là bắt
# buộc đổi trước khi dùng thật.

# --- Image (quy ước chung workspace) ---
# Tag đầy đủ: ${IM_REGISTRY}/fe | fe-gateway | fe-sql | fe-nosql : ${IM_TAG}
IM_REGISTRY=intramind
IM_TAG=devops
# Tiền tố tên container / volume — stack thử song song đặt imtest- / imtest_
CONTAINER_PREFIX=intramind-
VOLUME_PREFIX=intramind_

# --- Gateway backend-fastapi (:5050) ---
BACKEND_PORT=5050
FRONTEND_ORIGIN=http://localhost:8001
JWT_EXPIRES_IN=24h
# BẮT BUỘC đổi cho môi trường thật — để trống thì gateway tự sinh secret tạm
# thời và token không sống qua restart.
JWT_SECRET=change-me
LLM_API_KEY=  # API key thượng nguồn (nếu AI service cần)

# Upstream AI — mặc định là DNS service-name trên mạng intramind_net:
#   AI_SERVICE_HOST -> ai-api  (:5001, mta-ai-intramind — query/stream/tools)
#   AI_INGEST_HOST  -> be-api  (:5002, mta-be-intramind — upload/process/status)
# LƯU Ý chiều dễ nhầm (trap #3 CLAUDE.md workspace): SERVICE=5001, INGEST=5002.
# Nếu AI/BE chạy bare-metal trên host thì đổi sang:
#   http://host.docker.internal:5001/api/v1 và http://host.docker.internal:5002/api/v1
AI_SERVICE_HOST=http://ai-api:5001/api/v1
AI_INGEST_HOST=http://be-api:5002/api/v1

# Ngưỡng phát hiện zombie task — phải LỚN HƠN lần chạy draft/report chậm nhất
ZOMBIE_TASK_TIMEOUT_MS=1800000

# --- Frontend (:3000 trong container) ---
# Publish host 8001 — KHÔNG đặt 3000: đụng langfuse-web (hardcode 3000) và
# React dev server. Đường chính thức là nginx của infra (:8080) → frontend:3000.
FRONTEND_PORT=8001
# Target proxy nội bộ của server.js (/db /llm /tools) — DNS trong project
BACKEND_URL=http://backend:5050

# --- Postgres (users/RBAC/units/audit) ---
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=intramind

# --- Mongo (nội dung tin nhắn chat) ---
# Cổng publish phía host — KHÔNG đặt 27017 (mongo của tier infra đã chiếm).
# Trong mạng, backend vẫn nói chuyện với nosql-db:27017.
FE_MONGO_PORT=27018
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongoadmin
MONGO_DB=intramind

# --- Trần bộ nhớ (deploy.resources.limits) ---
FE_PG_MEM_LIMIT=1G
FE_PG_SHARED_BUFFERS=128MB
FE_PG_MAX_CONNECTIONS=50
FE_MONGO_MEM_LIMIT=2G
FE_MONGO_WT_CACHE_GB=1
FE_MIGRATE_MEM_LIMIT=512M
FE_SEED_MEM_LIMIT=512M
FE_BACKEND_MEM_LIMIT=1G
FE_FRONTEND_MEM_LIMIT=1G

# ── Dev Space (bản thử nghiệm Voice RAG) ────────────────────────────
# Bỏ trống cả 3 dòng dưới = bản IntraMind bình thường.

# "devspace" bật skin đỏ + logo DEV SPACE. Runtime, không cần build lại.
REACT_APP_BRAND=devspace

# Chặn ghi vào kho tài liệu thật. HAI dòng này phải LUÔN bằng nhau:
#   DEV_READONLY_CORPUS      = chốt chặn thật (gateway từ chối, 403)
#   REACT_APP_READONLY_CORPUS = lớp UX (ẩn nút upload)
# Bật khi AI_INGEST_HOST trỏ vào BE của stack KHÁC (vd. staging thật).
DEV_READONLY_CORPUS=true
REACT_APP_READONLY_CORPUS=true

# ⚠ BẪY #3: AI_SERVICE_HOST→:5001 (AI, hỏi đáp), AI_INGEST_HOST→:5002 (BE,
# tài liệu). Không đối xứng, rất dễ đảo. Triệu chứng khi đảo: chat 502 mà
# upload vẫn chạy, hoặc ngược lại.
# Dev Space trên ccoex: AI voice ở :15001 (bare-metal), BE thật ở :5002.
# AI_SERVICE_HOST=http://host.docker.internal:15001/api/v1
# AI_INGEST_HOST=http://host.docker.internal:5002/api/v1
